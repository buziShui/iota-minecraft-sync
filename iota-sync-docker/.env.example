# 请复制为 .env，并设置管理员账号和至少 12 位的强密码。不要提交真实密码。
IOTA_ADMIN_USERNAME=admin
IOTA_ADMIN_PASSWORD=请替换为至少12位的随机强密码

# 可选：连接现有 MSLX Daemon。API Key 只会保存在 Iota 服务端，不会发给浏览器。
IOTA_MSLX_BASE_URL=http://host.docker.internal:1027
IOTA_MSLX_PUBLIC_URL=http://192.168.1.2:1027
IOTA_MSLX_API_KEY=请填写MSLX全局API密钥
IOTA_MSLX_SERVERS_ROOT=/servers
